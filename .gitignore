build/
sdkconfig
sdkconfig.old
managed_components/
dependencies.lock
# tests/consumer is an application, not a component: its lockfile is committed so
# CI and re-runs against published tags resolve the same dependency versions.
!tests/consumer/dependencies.lock
__pycache__/
*.pyc

# Host test artefacts. Every <component>/test/Makefile links one binary beside
# its own sources, so match that shape instead of naming each one -- a new
# component's test binary is then ignored without touching this file.
*/test/test_*
!*/test/test_*.c
!*/test/test_*.h
js2c/test/generated/
